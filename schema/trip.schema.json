{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "Day": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "type": "string",
          "description": "日期，必须在旅行起止日期内"
        },
        "label": {
          "type": "string",
          "description": "当天标题，如“苏州 → 上海”；为空时显示日期"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array",
          "description": "按执行时间排列的事项",
          "defaultSnippets": [
            {
              "label": "新事项",
              "description": "插入一条行程事项",
              "body": [
                {
                  "title": "$1",
                  "type": "${2|交通,住宿,游览,餐饮,日常,购物,其他|}",
                  "start": "^\"${3:09:00}\"",
                  "end": "^\"${4:10:00}\"",
                  "status": "${5|无需预订,待购买,待预约,已购买,已预约,已完成,已取消|}"
                }
              ]
            }
          ]
        }
      },
      "required": [
        "date",
        "items"
      ],
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "type": "string",
          "description": "事项名称，如 高铁、入住、早餐"
        },
        "type": {
          "enum": [
            "交通",
            "住宿",
            "游览",
            "餐饮",
            "日常",
            "购物",
            "其他"
          ],
          "type": "string",
          "description": "类型"
        },
        "start": {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string",
          "description": "开始时间，带引号的 \"HH:MM\"，可手输精确时间如 \"19:28\"",
