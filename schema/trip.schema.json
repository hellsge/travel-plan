          ]
        },
        "note": {
          "type": "string",
          "description": "路线、车次、地址、营业时间等"
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "单价（人民币）"
        },
        "qty": {
          "type": "number",
          "minimum": 0,
          "description": "数量；消费 = price × qty"
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "description": "总价，仅在无法拆成单价 × 数量时填写，不能与 price / qty 同时出现"
        },
        "booking_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}( ([01]\\d|2[0-3]):[0-5]\\d)?$",
          "description": "开售 / 预约时间，如 2026-08-01 或 2026-08-02 14:00"
        },
        "status": {
          "default": "无需预订",
          "enum": [
            "无需预订",
            "待购买",
            "待预约",
            "已购买",
            "已预约",
            "已完成",
            "已取消"
          ],
          "type": "string",
          "description": "预订状态，默认“无需预订”"
        },
        "place": {
          "type": "string",
          "description": "地图关键词，填写后页面显示地图按钮"
        }
      },
      "required": [
        "title",
        "type"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "minLength": 1,
      "type": "string",
      "description": "旅行标题"
    },
    "start": {
      "format": "date",
      "type": "string",
      "description": "旅行开始日期，如 2026-08-02"
    },
    "end": {
      "format": "date",
      "type": "string",
      "description": "旅行结束日期，不早于 start"
    },
    "travelers": {
      "minimum": 1,
      "type": "integer",
      "description": "人数，用于计算人均花销"
    },
    "notes": {
      "type": "string",
      "description": "整体说明，如行程原则"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/Day"
      },
      "minItems": 1,
      "type": "array",
      "description": "按日期递增排列的每日行程",
      "defaultSnippets": [
        {
          "label": "新的一天",
          "description": "插入一天及一条事项",
          "body": [
            {
              "date": "${1:2026-01-01}",
              "label": "$2",
              "items": [
                {
                  "title": "$3",
                  "type": "${4|交通,住宿,游览,餐饮,日常,购物,其他|}"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "required": [
    "title",
    "start",
    "end",
    "days"
  ],
  "type": "object"
}
